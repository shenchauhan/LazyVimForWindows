  "lines": [
    { "id": "struggle-1", "text": "Setting up Neovim on Windows?" },
    { "id": "struggle-2", "text": "Compilers, PATH variables, 47 browser tabs." },
    { "id": "struggle-3", "text": "And there goes your weekend." },
    { "id": "hook-1", "text": "But not anymore." },
    { "id": "hook-2", "text": "Meet LazyVim for Windows." },
    { "id": "command", "text": "One script. One command. That's it!" },
    { "id": "winget", "text": "Powered by WinGet, it installs Neovim, Git, a C compiler, Tree-sitter, and fast search tools, all on its own." },
    { "id": "arch", "text": "x64, x86, or ARM64? It detects your machine and picks the right compiler." },
    { "id": "safe", "text": "Already have a config? Relax. It's backed up first. Safe by default." },
    { "id": "launch-1", "text": "Then fire up Neovim..." },
    { "id": "launch-2", "text": "And there it is!" },
    { "id": "launch-3", "text": "A gorgeous, batteries-included editor, ready to roll." },
    { "id": "cta", "text": "LazyVim for Windows. Less setup, more coding. Grab it on GitHub." }
  ],
